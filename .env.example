# Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (Supabase)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/commongood
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stellar Blockchain
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
GOVERNANCE_CONTRACT_ID=your-contract-id
IDENTITY_CONTRACT_ID=your-identity-contract-id
PROJECTS_CONTRACT_ID=your-projects-contract-id

# Stellar Keypairs (testnet only - NEVER production!)
STELLAR_MASTER_KEYPAIR=S...
STELLAR_VOTER_KEYPAIR=S...

# Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+27...

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# AI Agent Services
AI_AGENT_URL=http://localhost:8000
AI_AGENT_API_KEY=your-api-key

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Development
DEBUG=commongood:*
SEED_DATABASE=false